---
import { getMarcas } from '../lib/cms';
const marcas = (await getMarcas()).filter((m) => m.entry.logo);
const loop = [...marcas, ...marcas, ...marcas, ...marcas];
---
{marcas.length > 0 && (
<section aria-labelledby="marcas-t" class="flex flex-col gap-12 overflow-hidden bg-navy py-14 text-white">
  <div class="mx-auto flex w-full max-w-[1280px] flex-wrap items-baseline justify-between gap-4 px-6">
    <h2 id="marcas-t" class="m-0 text-[28px] font-bold tracking-[-0.02em]">Marcas que confían en nosotros</h2>
    <span class="text-[15px] font-bold text-cyan" data-reveal="title">Más de 15 años de experiencia</span>
  </div>
  <div class="mq-wrap overflow-hidden border-y border-[#34507A] py-9">
    <ul class="mq m-0 flex w-max list-none items-center gap-[120px] p-0 pr-[120px]" aria-label="Logos de marcas">
      {loop.map((m, i) => (
        <li aria-hidden={i >= marcas.length ? 'true' : undefined}>
          <img src={m.entry.logo} alt={i < marcas.length ? m.entry.nombre : ''} class="h-12 w-auto max-w-[200px] object-contain" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>
)}
<style>
  @keyframes mqL { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .mq { animation: mqL 40s linear infinite; }
  .mq-wrap:hover .mq { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .mq { animation: none; flex-wrap: wrap; justify-content: center; width: auto; } }
</style>
