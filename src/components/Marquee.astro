---
import { getMarcas } from '../lib/cms';
const marcas = (await getMarcas()).filter((m) => m.entry.logo);
// Dos copias alcanzan (cada tanda es más ancha que la pantalla) y la animación corre -50%.
const loop = [...marcas, ...marcas];
---
{marcas.length > 0 && (
<section aria-labelledby="marcas-t" class="flex flex-col gap-8 overflow-hidden bg-navy py-10 text-white md:gap-12 md:py-14">
  <div class="mx-auto flex w-full max-w-[1280px] flex-wrap items-baseline justify-between gap-x-4 gap-y-3 px-6">
    <h2 id="marcas-t" class="m-0 text-[28px] leading-[1.1] font-bold tracking-[-0.02em]">Marcas que confían en nosotros</h2>
    <span class="text-[15px] font-bold text-cyan" data-reveal="title">Más de 15 años de experiencia</span>
  </div>
  <div class="mq-wrap overflow-hidden border-y border-[#34507A] py-7 md:py-9">
    <ul class="mq m-0 flex w-max list-none items-center gap-12 p-0 pr-12 md:gap-[120px] md:pr-[120px]" aria-label="Logos de marcas">
      {loop.map((m, i) => (
        <li aria-hidden={i >= marcas.length ? 'true' : undefined}>
          <img src={m.entry.logo} alt={i < marcas.length ? m.entry.nombre : ''} class="h-10 w-auto max-w-[150px] object-contain md:h-12 md:max-w-[200px]" loading="eager" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>
)}
<style>
  @keyframes mqL { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }
  .mq { animation: mqL 30s linear infinite; will-change: transform; backface-visibility: hidden; }
  .mq-wrap:hover .mq { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .mq { animation: none; flex-wrap: wrap; justify-content: center; width: auto; } }
</style>
