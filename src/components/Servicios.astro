---
// Servicios como fichas que se apilan al scrollear y dejan visible su pestaña (número + título).
import { reader, getServicios } from '../lib/cms';
const inicio = await reader.singletons.inicio.read();
const servicios = await getServicios();
const TOP = 96, TAB = 84, H = 700; // todas las fichas terminan a la misma altura: se sueltan juntas
---
<div class="bg-slate-50">
  <section id="servicios" aria-labelledby="serv-t" class="mx-auto max-w-[1280px] scroll-mt-20 px-6">
    <div class="flex flex-wrap items-start justify-between gap-12 pt-24 pb-18">
      <h2 id="serv-t" class="m-0 max-w-[11em] text-[clamp(30px,4vw,56px)] text-balance leading-[1.02] font-bold tracking-[-0.03em]">{inicio?.serviciosTitulo}</h2>
      <p class="m-0 mt-2 max-w-[400px] text-[17px] leading-normal font-bold text-orange-text">{inicio?.serviciosIntro}</p>
    </div>
    {servicios.map(({ slug, entry }, i) => (
      <article aria-labelledby={`svc-${slug}`} data-svc data-open={i === 0 ? '' : undefined}
        class="svc relative grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-4 border-t border-cyan bg-slate-50 pt-5 pb-5 md:grid-cols-[140px_minmax(0,1fr)_400px] md:gap-x-8 md:pt-[22px] md:pb-10"
        style={`--top:${TOP + i * TAB}px;--h:${H - TAB * i}px`}>
        <span class="svc-num pt-1.5 text-[13px] leading-none font-bold tracking-[-0.02em] text-cyan-text md:pt-0 md:text-4xl md:text-navy">{String(i + 1).padStart(2, '0')}</span>
        <div class="flex flex-col gap-2.5 pr-12 md:pr-0">
          <h3 id={`svc-${slug}`} class="m-0 text-[22px] leading-none font-bold tracking-[-0.025em] text-navy md:text-[38px] md:text-orange">
            <a href={`/servicios/${slug}`} class="hover:underline">{entry.titulo}</a>
          </h3>
          <span class="svc-body mt-4 text-[13px] text-orange-text">[ {entry.bajada} ]</span>
          <ul class="svc-body m-0 flex list-none flex-col gap-1.5 p-0">
            {entry.items.map((it) => <li class="text-lg leading-snug text-slate-700">{it}</li>)}
          </ul>
        </div>
        <p class="svc-body col-span-2 m-0 text-base leading-normal font-bold md:col-span-1 md:mt-[74px]">{entry.descripcion}</p>
        <button type="button" class="svc-toggle absolute top-2.5 right-0 flex h-11 w-11 items-center justify-center text-navy md:hidden" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`svc-b-${slug}`} data-svc-toggle>
          <span class="sr-only">Ver detalle de {entry.titulo}</span>
          <svg aria-hidden="true" class="svc-plus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        </button>
      </article>
    ))}
  </section>
</div>
<style>
  /* El apilado solo en pantallas grandes; en celular las fichas van una debajo de otra. */
  @media (min-width: 768px) {
    .svc { position: sticky; top: var(--top); height: var(--h); }
  }
  /* Números: cuentan de 00 a su valor al entrar cada ficha en pantalla. */
  .svc-num { font-variant-numeric: tabular-nums; }
  /* En celular: acordeón (como el diseño mobile). Solo se pliega si hay JS. */
  @media (max-width: 767px) {
    [data-acc] .svc:not([data-open]) .svc-body { display: none; }
    .svc[data-open] { padding-bottom: 28px; }
    .svc-plus { transition: transform .22s cubic-bezier(.23,1,.32,1); }
    .svc[data-open] .svc-plus { transform: rotate(45deg); }
  }
</style>
<script>
  const sec = document.getElementById('servicios');
  if (sec) {
    sec.setAttribute('data-acc', '');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const count = (el: HTMLElement) => {
        const fin = parseInt(el.dataset.n ?? '0', 10), dur = 500 + fin * 150, t0 = performance.now();
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(fin * (1 - Math.pow(1 - k, 3)))).padStart(2, '0');
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const nums = sec.querySelectorAll<HTMLElement>('.svc-num');
      nums.forEach((n) => { n.dataset.n = n.textContent?.trim() ?? '0'; n.textContent = '00'; });
      const io = new IntersectionObserver((entries) => entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const n = en.target.querySelector<HTMLElement>('.svc-num');
        if (n) count(n);
        io.unobserve(en.target);
      }), { threshold: 0.35 });
      sec.querySelectorAll('[data-svc]').forEach((a) => io.observe(a));
    }
    sec.querySelectorAll<HTMLButtonElement>('[data-svc-toggle]').forEach((b) => b.addEventListener('click', () => {
      const art = b.closest<HTMLElement>('[data-svc]');
      if (!art) return;
      const open = !art.hasAttribute('data-open');
      art.toggleAttribute('data-open', open);
      b.setAttribute('aria-expanded', String(open));
    }));
  }
</script>
