---
// "ALANMARINO" en Bowlby One (la tipografía de HABLEMOS).
// fit = true: escala al ancho del contenedor sin deformar las letras (footer gigante).
interface Props { class?: string; fit?: boolean; label?: string }
const { class: className = '', fit = false, label = 'Alan Marino' } = Astro.props;
---
{fit ? (
  <svg class={className} viewBox="-4 -144 1475 150" role="img" aria-label={label}>
    <text x="0" y="0" fill="currentColor" style="font-family:'Bowlby One','Helvetica Neue',sans-serif;font-size:190px">ALANMARINO</text>
  </svg>
) : (
  <span class:list={['font-display leading-none tracking-[0.01em] whitespace-nowrap', className]} role="img" aria-label={label}>ALANMARINO</span>
)}
