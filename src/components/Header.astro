---
import Wordmark from './Wordmark.astro';
import Arrow from './Arrow.astro';
import { NAV } from '../lib/nav';
import { getAjustes } from '../lib/seo';
const a = await getAjustes();
const redes = [
  { label: 'Instagram', href: a?.instagram },
  { label: 'Behance', href: a?.behance },
  { label: 'LinkedIn', href: a?.linkedin },
].filter((r) => r.href);
const MENU = [...NAV, { href: '/contacto', label: 'Contacto' }];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(href + '/'));
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-4 px-6 py-2.5 md:py-[18px]">
    <a href="/" aria-label="Alan Marino, inicio" class="flex items-center text-navy">
      <Wordmark short class="text-[25px] md:text-[30px]" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1 text-base font-medium md:flex">
      {NAV.map((n) => (
        <a
          href={n.href}
          aria-current={isCurrent(n.href) ? 'page' : undefined}
          class:list={['px-4 py-3 text-navy hover:text-cyan-text', isCurrent(n.href) && 'font-bold underline decoration-cyan decoration-2 underline-offset-[6px]']}
        >{n.label}</a>
      ))}
      <a href="/contacto" aria-current={isCurrent('/contacto') ? 'page' : undefined} data-fx="fill" data-fx-arrow
        class="ml-2 rounded-md bg-orange px-[22px] py-[11px] text-[19px] font-bold text-white hover:bg-orange-hover"
        style="--fx-fill:#183057;--fx-text:#FFFFFF">Contacto<Arrow /></a>
    </nav>
    <button type="button" class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-cyan text-navy md:hidden"
      aria-expanded="false" aria-controls="menu-mobile" data-menu-open>
      <span class="sr-only">Abrir menú</span>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div id="menu-mobile" class="fixed inset-0 z-50 hidden flex-col overflow-hidden bg-navy text-white" role="dialog" aria-modal="true" aria-label="Menú" data-menu>
    <div class="flex h-16 flex-none items-center justify-between border-b border-[#34507A] pr-3 pl-6">
      <a href="/" aria-label="Alan Marino, inicio" class="text-white"><Wordmark short class="text-[25px]" /></a>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-cyan text-navy" data-menu-close>
        <span class="sr-only">Cerrar menú</span>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav aria-label="Menú móvil" class="flex flex-col px-6 pt-8">
      {MENU.map((n, i) => (
        <a href={n.href} class="flex items-baseline gap-3 border-b border-[#34507A] py-3.5 text-[44px] leading-none font-bold tracking-[-0.035em] text-white" data-menu-link>
          <span class="w-6 flex-none text-[13px] font-bold tracking-normal text-cyan">{String(i + 1).padStart(2, '0')}</span>{n.label}
        </a>
      ))}
    </nav>
    <div class="flex flex-col gap-5 px-6 pt-8">
      <a href="/contacto" class="flex items-center justify-center gap-2.5 rounded-[10px] bg-orange px-5 py-4 text-[19px] font-bold text-white" data-menu-link>Hablemos
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      {redes.length > 0 && <div class="flex gap-5 text-[15px]">{redes.map((r) => <a href={r.href} class="py-2 text-white">{r.label}</a>)}</div>}
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-[22px] -left-5 w-[calc(100%+40px)] text-cyan"><Wordmark fit class="block h-auto w-full" /></div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  function setOpen(open: boolean) {
    if (!menu || !openBtn) return;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  }
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) setOpen(false); });
</script>
