---
import Wordmark from './Wordmark.astro';
import Arrow from './Arrow.astro';
import { NAV } from '../lib/nav';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(href + '/'));
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-4 px-6 py-[18px]">
    <a href="/" aria-label="Alan Marino, inicio" class="flex items-center text-navy">
      <Wordmark short class="text-[30px]" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1 text-base font-medium md:flex">
      {NAV.map((n) => (
        <a
          href={n.href}
          aria-current={isCurrent(n.href) ? 'page' : undefined}
          class:list={['px-4 py-3 text-navy hover:text-cyan-text', isCurrent(n.href) && 'font-bold underline decoration-cyan decoration-2 underline-offset-[6px]']}
        >{n.label}</a>
      ))}
      <a href="/contacto" aria-current={isCurrent('/contacto') ? 'page' : undefined} data-fx="fill" data-fx-arrow
        class="ml-2 rounded-md bg-orange px-[22px] py-[11px] text-[19px] font-bold text-white hover:bg-orange-hover"
        style="--fx-fill:#183057;--fx-text:#FFFFFF">Contacto<Arrow /></a>
    </nav>
    <button type="button" class="flex h-12 w-12 items-center justify-center rounded-md border border-navy md:hidden"
      aria-expanded="false" aria-controls="menu-mobile" data-menu-open>
      <span class="sr-only">Abrir menú</span>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div id="menu-mobile" class="fixed inset-0 z-50 hidden flex-col bg-navy text-white" role="dialog" aria-modal="true" aria-label="Menú" data-menu>
    <div class="flex items-center justify-between px-6 py-[18px]">
      <a href="/" aria-label="Alan Marino, inicio" class="text-cyan"><Wordmark short class="text-[30px]" /></a>
      <button type="button" class="flex h-12 w-12 items-center justify-center rounded-md border border-cyan" data-menu-close>
        <span class="sr-only">Cerrar menú</span>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav aria-label="Menú móvil" class="flex flex-1 flex-col justify-center gap-2 px-6">
      {NAV.map((n) => <a href={n.href} class="py-2 text-5xl font-bold tracking-[-0.03em] text-white hover:text-cyan" data-menu-link>{n.label}</a>)}
      <a href="/contacto" class="mt-6 self-start rounded-md bg-orange px-6 py-4 text-xl font-bold text-white" data-menu-link>Contacto</a>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  function setOpen(open: boolean) {
    if (!menu || !openBtn) return;
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  }
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) setOpen(false); });
</script>
