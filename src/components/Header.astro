---
import Wordmark from './Wordmark.astro';
import Arrow from './Arrow.astro';
import { NAV } from '../lib/nav';
import { getAjustes } from '../lib/seo';
const a = await getAjustes();
const redes = [
  { label: 'Instagram', href: a?.instagram },
  { label: 'Behance', href: a?.behance },
  { label: 'LinkedIn', href: a?.linkedin },
].filter((r) => r.href);
const MENU = [...NAV, { href: '/contacto', label: 'Contacto' }];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(href + '/'));
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-4 px-6 py-2.5 md:py-[18px]">
    <a href="/" aria-label="Alan Marino, inicio" class="flex items-center text-navy">
      <Wordmark short class="text-[25px] md:text-[30px]" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1 text-base font-medium md:flex">
      {NAV.map((n) => (
        <a
          href={n.href}
          aria-current={isCurrent(n.href) ? 'page' : undefined}
          class:list={['px-4 py-3 text-navy hover:text-cyan-text', isCurrent(n.href) && 'font-bold underline decoration-cyan decoration-2 underline-offset-[6px]']}
        >{n.label}</a>
      ))}
      <a href="/contacto" aria-current={isCurrent('/contacto') ? 'page' : undefined} data-fx="fill" data-fx-arrow
        class="ml-2 rounded-md bg-orange px-[22px] py-[11px] text-[19px] font-bold text-white hover:bg-orange-hover"
        style="--fx-fill:#183057;--fx-text:#FFFFFF">Contacto<Arrow /></a>
    </nav>
    <button type="button" class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-cyan text-navy md:hidden"
      aria-expanded="false" aria-controls="menu-mobile" data-menu-open>
      <span class="sr-only">Abrir menú</span>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div id="menu-mobile" class="fixed inset-0 z-50 hidden flex-col overflow-hidden bg-navy text-white" role="dialog" aria-modal="true" aria-label="Menú" data-menu>
    <div class="mm-top flex h-16 flex-none items-center justify-between border-b border-[#34507A] pr-3 pl-6">
      <a href="/" aria-label="Alan Marino, inicio" class="text-white"><Wordmark short class="text-[25px]" /></a>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-[10px] bg-cyan text-navy" data-menu-close>
        <span class="sr-only">Cerrar menú</span>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav aria-label="Menú móvil" class="flex flex-col px-6 pt-8">
      {MENU.map((n, i) => (
        <a href={n.href} class="mm-link relative block py-3.5 text-[44px] leading-none font-bold tracking-[-0.035em] text-white" data-menu-link>
          <span class="block overflow-hidden pt-[.08em] pb-[.14em] -mt-[.08em] -mb-[.14em]"><span class="mm-txt flex items-baseline gap-3"><span class="w-6 flex-none text-[13px] font-bold tracking-normal text-cyan">{String(i + 1).padStart(2, '0')}</span>{n.label}</span></span>
          <span class="mm-line absolute right-0 bottom-0 left-0 h-px origin-left bg-[#34507A]" aria-hidden="true"></span>
        </a>
      ))}
    </nav>
    <div class="mm-foot flex flex-col gap-5 px-6 pt-8">
      <a href="/contacto" class="flex items-center justify-center gap-2.5 rounded-[10px] bg-orange px-5 py-4 text-[19px] font-bold text-white" data-menu-link>Hablemos
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      {redes.length > 0 && <div class="flex gap-5 text-[15px]">{redes.map((r) => <a href={r.href} class="py-2 text-white">{r.label}</a>)}</div>}
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute right-6 bottom-6 left-6 text-cyan"><Wordmark fit letters class="mm-mark block h-auto w-full" /></div>
  </div>
</header>

<script>
  import { gsap } from 'gsap';
  // Menú mobile: se abre como un círculo que crece desde el botón; los links suben uno por uno,
  // las líneas se dibujan y el ALANMARINO aparece letra por letra. Al cerrar, todo se recoge rápido.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let tl: gsap.core.Timeline | null = null;
  let isOpen = false;

  function origen() {
    const r = openBtn?.getBoundingClientRect();
    return r ? `${r.left + r.width / 2}px ${r.top + r.height / 2}px` : '100% 0%';
  }
  function build() {
    if (!menu) return null;
    const o = origen();
    const t = gsap.timeline({ paused: true, defaults: { ease: 'expo.out' } });
    t.fromTo(menu, { clipPath: `circle(0px at ${o})` }, { clipPath: `circle(150vmax at ${o})`, duration: 0.75, ease: 'expo.inOut' })
      .from(menu.querySelectorAll('.mm-top > *'), { opacity: 0, y: -12, duration: 0.5, stagger: 0.06 }, 0.35)
      .from(menu.querySelectorAll('.mm-txt'), { yPercent: 115, duration: 0.9, stagger: 0.07 }, 0.4)
      .from(menu.querySelectorAll('.mm-line'), { scaleX: 0, duration: 0.9, stagger: 0.07, ease: 'expo.inOut' }, 0.38)
      .from(menu.querySelectorAll('.mm-foot > *'), { opacity: 0, y: 24, duration: 0.7, stagger: 0.08 }, 0.6)
      .fromTo(menu.querySelectorAll('.mm-mark tspan'), { attr: { y: 170 }, opacity: 0 }, { attr: { y: 0 }, opacity: 1, duration: 0.9, stagger: 0.04 }, 0.55);
    return t;
  }
  function setOpen(open: boolean) {
    if (!menu || !openBtn || open === isOpen) return;
    isOpen = open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) window.__lenis?.stop(); else window.__lenis?.start();
    if (open) {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      closeBtn?.focus();
      if (reduce) return;
      tl?.kill();
      tl = build();
      tl?.timeScale(1).play(0);
    } else {
      const hide = () => { menu.classList.add('hidden'); menu.classList.remove('flex'); gsap.set(menu.querySelectorAll('.mm-txt, .mm-foot > *, .mm-mark'), { clearProps: 'all' }); gsap.set(menu, { clearProps: 'clipPath' }); openBtn.focus(); };
      if (reduce) return hide();
      tl?.kill();
      const o = origen();
      tl = gsap.timeline({ onComplete: hide })
        .to(menu.querySelectorAll('.mm-txt'), { yPercent: -115, duration: 0.35, stagger: 0.03, ease: 'power3.in' }, 0)
        .to(menu.querySelectorAll('.mm-foot > *, .mm-mark'), { opacity: 0, duration: 0.25 }, 0)
        .to(menu, { clipPath: `circle(0px at ${o})`, duration: 0.55, ease: 'expo.inOut' }, 0.12);
    }
  }
  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  // Un link navega: se cierra sin animación para no frenar la carga de la página.
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) setOpen(false); });
</script>
