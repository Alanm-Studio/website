---
import { getHistorias } from '../lib/cms';
import { getAjustes } from '../lib/seo';
import ReelSlider from './ReelSlider.astro';
const historias = (await getHistorias()).filter((h) => h.entry.portada);
const a = await getAjustes();
// Sin Instagram del estudio cargado en Ajustes, el botón no se muestra (antes iba a instagram.com genérico).
const ig = a?.instagram || '';
const TIPO = { reel: 'Reel', post: 'Post', historia: 'Destacada' } as const;
---
{historias.length > 0 && (
<section class="overflow-x-clip border-t border-slate-200 bg-white pt-16 pb-16 md:pt-26 md:pb-24" aria-labelledby="ig-t" id="reels">
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-end justify-between gap-x-12 gap-y-4 px-6">
    <div>
      <p class="m-0 mb-4 text-[15px] font-bold text-cyan-text">Lo último en Instagram</p>
      <h2 id="ig-t" class="m-0 text-[clamp(36px,4vw,56px)] leading-[1.02] font-bold tracking-[-0.03em]">Reels</h2>
    </div>
    <div class="flex max-w-[380px] flex-col items-start gap-5 md:items-end md:text-right">
      <p class="m-0 text-lg leading-normal text-slate-700">Procesos, lanzamientos y el día a día del estudio, en formato corto.</p>
      {ig && <a href={ig} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2.5 rounded-md bg-orange px-6 py-[15px] text-lg font-bold text-white hover:bg-orange-hover">Seguinos en Instagram<span class="sr-only"> (se abre en otra pestaña)</span><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg></a>}
    </div>
  </div>
  <div class="mt-8 md:mt-12">
    <ReelSlider items={historias.map(({ entry }) => ({ titulo: entry.titulo, portada: entry.portada!, link: entry.link, alt: entry.alt, chip: TIPO[entry.tipo], play: entry.tipo !== 'post' }))} label="Reels de Instagram, desplazable" />
  </div>
</section>
)}
