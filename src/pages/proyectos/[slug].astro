---
import Markdoc from '@markdoc/markdoc';
import Site from '../../layouts/Site.astro';
import { getProyectos } from '../../lib/cms';
import { breadcrumbJsonLd } from '../../lib/seo';
import ReelSlider from '../../components/ReelSlider.astro';

export async function getStaticPaths() {
  const todos = await getProyectos();
  return todos.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, prev: todos[(i - 1 + todos.length) % todos.length], next: todos[(i + 1) % todos.length] },
  }));
}

const { p, prev, next } = Astro.props;
const e = p.entry;
const contenido = await e.contenido();
const html = Markdoc.renderers.html(Markdoc.transform(contenido.node));
const SERV: Record<string, string> = { marketing: 'Marketing', marca: 'Marca', 'sistema-visual': 'Sistema visual', editorial: 'Editorial', web: 'Web' };
const servicios = [p.servicioTitulo, ...e.otrosServicios.filter((s) => s !== p.servicio).map((s) => SERV[s])];
const portada = e.portada;
const galeria = e.galeria.filter((g) => g.imagen && g.imagen !== portada);

function embed(url?: string | null) {
  if (!url) return null;
  const yt = url.match(/(?:youtu\.be\/|v=|shorts\/)([\w-]{11})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  const ig = url.match(/instagram\.com\/(?:reel|p)\/([\w-]+)/);
  if (ig) return `https://www.instagram.com/reel/${ig[1]}/embed`;
  return null;
}
const esReel = !!e.video && /instagram\.com/.test(e.video);
const reels = e.reels ?? [];
const video = embed(e.video);
const site = Astro.site!;
const jsonLd = [
  breadcrumbJsonLd(site, [{ nombre: 'Inicio', path: '/' }, { nombre: 'Proyectos', path: '/proyectos' }, { nombre: e.titulo, path: `/proyectos/${p.slug}` }]),
  {
    '@context': 'https://schema.org', '@type': 'CreativeWork', name: e.titulo, url: new URL(`/proyectos/${p.slug}`, site).href,
    image: (portada || e.miniatura) ? new URL((portada || e.miniatura)!, site).href : undefined,
    creator: { '@id': new URL('/#estudio', site).href }, dateCreated: e.anio ? String(e.anio) : undefined,
    about: servicios, sourceOrganization: e.cliente ? { '@type': 'Organization', name: e.cliente } : undefined,
  },
];
// Como en el board: primeras 3 imágenes en 3 columnas, video, y el resto en 2 columnas.
const galeriaA = galeria.slice(0, 3);
const galeriaB = galeria.slice(3);
const col = (f: string) => (f === 'completo' ? 'col-span-full' : f === 'horizontal' ? 'md:col-span-2' : '');
const ratio = (f: string) => (f === 'completo' ? 'h-auto' : f === 'horizontal' ? 'aspect-[16/9]' : f === 'cuadrado' ? 'aspect-square' : 'aspect-[4/5]');
const imgCls = (f: string) => ['w-full rounded-md', f === 'completo' ? 'mx-auto max-w-[1040px]' : 'object-cover', ratio(f), col(f)];
---
<Site title={e.seo?.titulo || e.titulo} description={e.seo?.descripcion || e.bajada || `${e.titulo}: proyecto de ${servicios.join(', ').toLowerCase()} de Alan Marino Studio.`}
  image={e.seo?.imagen || portada || e.miniatura} type="article" noindex={e.seo?.noindex} jsonLd={jsonLd}>
  <section class="mx-auto flex max-w-[1280px] flex-col gap-6 px-6 pt-10 pb-8 md:pt-12 md:pb-10">
    <nav aria-label="Ruta" class="flex items-center gap-2 text-[15px] text-slate-500">
      <a href="/proyectos" class="py-2 text-navy underline underline-offset-4 hover:text-cyan-text">Proyectos</a><span aria-hidden="true">/</span><span>{p.servicioTitulo}</span>
    </nav>
    <h1 class="m-0 text-[clamp(48px,7vw,96px)] leading-[.98] font-bold tracking-[-0.035em]">{e.titulo}</h1>
    <div class="flex flex-wrap gap-2">{servicios.map((s) => <span class="rounded-md bg-cyan-tint px-3.5 py-2 text-sm font-bold" data-reveal="title">{s}</span>)}</div>
  </section>

  {e.portadaVideo ? (
    <div class="mx-auto max-w-[1280px] px-6">
      <video src={e.portadaVideo} class="aspect-[16/9] w-full rounded-md bg-slate-100 object-cover" autoplay muted playsinline preload="auto" aria-label={`Animación de apertura del proyecto ${e.titulo}`} data-apertura></video>
    </div>
  ) : portada && (
    <div class="mx-auto max-w-[1280px] px-6">
      <img src={portada} alt={`Portada del proyecto ${e.titulo}`} class="aspect-[16/8] w-full rounded-md object-cover" />
    </div>
  )}

  <section class="mx-auto flex max-w-[1280px] flex-wrap gap-12 px-6 py-10 md:py-16">
    <dl class="m-0 flex-[1_1_280px] self-start border-t border-cyan">
      {e.cliente && <div class="border-b border-slate-200 py-3"><dt class="text-sm text-slate-500" data-reveal="title">Cliente</dt><dd class="m-0 mt-1 text-[17px] font-bold" data-reveal="title">{e.cliente}</dd></div>}
      {e.anio && <div class="border-b border-slate-200 py-3"><dt class="text-sm text-slate-500" data-reveal="title">Año</dt><dd class="m-0 mt-1 text-[17px] font-bold" data-reveal="title">{e.anio}</dd></div>}
      <div class="border-b border-slate-200 py-3"><dt class="text-sm text-slate-500" data-reveal="title">Servicios</dt><dd class="m-0 mt-1 text-[17px] font-bold" data-reveal="title">{e.serviciosFicha || servicios.join(' · ')}</dd></div>
      {e.sitioWeb && <div class="border-b border-slate-200 py-3"><dt class="text-sm text-slate-500">{/instagram\.com/.test(e.sitioWeb) ? 'Instagram' : 'Sitio web'}</dt><dd class="m-0 mt-1 text-[17px] font-bold"><a href={e.sitioWeb} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 underline decoration-cyan decoration-2 underline-offset-4 hover:text-cyan-text">{/instagram\.com/.test(e.sitioWeb) ? '@' + e.sitioWeb.replace(/\/$/, '').split('/').pop() : e.sitioWeb.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg><span class="sr-only"> (se abre en otra pestaña)</span></a></dd></div>}
    </dl>
    {e.imagenFicha ? (
      <div class="flex-[2_1_560px]">
        <img src={e.imagenFicha} alt={e.bajada || `Piezas del proyecto ${e.titulo}`} loading="lazy" decoding="async" class="w-full rounded-md" />
      </div>
    ) : (
    <div class="flex flex-[2_1_560px] flex-col gap-5">
      {e.bajada && <h2 class="m-0 text-[32px] leading-tight font-bold tracking-[-0.02em]">{e.bajada}</h2>}
      <div class="prosa text-lg leading-relaxed text-slate-700" set:html={html} />
      {e.presentacion && <a href={e.presentacion} class="self-start py-2.5 text-[17px] font-bold underline decoration-cyan decoration-2 underline-offset-4">{e.presentacionTexto || 'Ver presentación completa (PDF)'}</a>}
    </div>
    )}
  </section>

  {galeriaA.length > 0 && (
    <section aria-label="Galería" class="mx-auto max-w-[1280px] px-6 pb-10 md:pb-16">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {galeriaA.map((g) => <img src={g.imagen} alt={g.alt || ''} loading="lazy" decoding="async" class:list={imgCls(g.formato)} />)}
      </div>
    </section>
  )}

  {video && (
    <section aria-label="Video" class="mx-auto max-w-[1280px] px-6 pb-10 md:pb-16">
      {esReel ? (
        <div class="flex justify-center rounded-md bg-navy px-4 py-10">
          <iframe src={video} title={`Reel del proyecto ${e.titulo}`} class="h-[720px] w-full max-w-[400px] rounded-md bg-white" loading="lazy" allowfullscreen></iframe>
        </div>
      ) : (
        <iframe src={video} title={`Video del proyecto ${e.titulo}`} class="aspect-video w-full rounded-md" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
      )}
    </section>
  )}

  {galeriaB.length > 0 && (
    <section aria-label="Más imágenes" class="mx-auto max-w-[1280px] px-6 pb-16 md:pb-24">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        {galeriaB.map((g) => <img src={g.imagen} alt={g.alt || ''} loading="lazy" decoding="async" class:list={imgCls(g.formato)} />)}
      </div>
    </section>
  )}

  {reels.length > 0 && (
    <section aria-labelledby="reels-t" class="pb-12 md:pb-16">
      <h2 id="reels-t" class="mx-auto m-0 max-w-[1280px] px-6 pb-6 text-[clamp(26px,3vw,36px)] font-bold tracking-[-0.02em]">Reels</h2>
      <ReelSlider items={reels.map((r) => ({ titulo: r.titulo, portada: r.portada!, link: r.link, chip: 'Reel' }))} label="Reels del proyecto, desplazable" />
    </section>
  )}

  {prev && next && prev.slug !== p.slug && (
    <nav aria-label="Otros proyectos" class="border-t border-slate-200">
      <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-6 px-6 py-10">
        <a href={`/proyectos/${prev.slug}`} class="flex flex-col gap-1 py-2 text-navy"><span class="text-sm text-slate-500" data-reveal="title">Anterior</span><span class="text-[22px] font-bold" data-reveal="title">{prev.entry.titulo}</span></a>
        <a href="/proyectos" class="py-3 font-bold text-navy underline underline-offset-4">Todos los proyectos</a>
        <a href={`/proyectos/${next.slug}`} class="flex flex-col items-end gap-1 py-2 text-navy"><span class="text-sm text-slate-500" data-reveal="title">Siguiente</span><span class="text-[22px] font-bold" data-reveal="title">{next.entry.titulo}</span></a>
      </div>
    </nav>
  )}

</Site>
<style is:global>
  .prosa p { margin: 0 0 1em; }
  .prosa a { color: #183057; text-decoration: underline; text-decoration-color: #00C0E8; text-underline-offset: 4px; }
  .prosa h2, .prosa h3 { color: #183057; letter-spacing: -0.02em; margin: 1.4em 0 .5em; }
  .prosa ul { padding-left: 1.2em; list-style: disc; }
</style>

<script>
  // Video de apertura: sin autoplay si el usuario prefiere menos movimiento.
  const ap = document.querySelector<HTMLVideoElement>('[data-apertura]');
  if (ap && matchMedia('(prefers-reduced-motion: reduce)').matches) {
    ap.removeAttribute('autoplay'); ap.pause();
    ap.addEventListener('loadedmetadata', () => { ap.currentTime = Math.max(0, ap.duration - 0.05); }, { once: true });
  }
</script>
