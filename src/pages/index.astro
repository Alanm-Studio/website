---
import Base from '../layouts/Base.astro';
import Site from '../layouts/Site.astro';
import MuyPronto from '../components/MuyPronto.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import Marquee from '../components/Marquee.astro';
import Servicios from '../components/Servicios.astro';
import Historias from '../components/Historias.astro';
import Arrow from '../components/Arrow.astro';
import { reader } from '../lib/cms';
import { getAjustes, organizationJsonLd, websiteJsonLd } from '../lib/seo';

const site = Astro.site!;
const ajustes = await getAjustes();
const inicio = await reader.singletons.inicio.read();
const jsonLd = [await organizationJsonLd(site), websiteJsonLd(site, ajustes?.seoSitio?.nombre || 'Alan Marino Studio')];
const seo = {
  rawTitle: inicio?.seo?.titulo || 'Alan Marino Studio — Branding, diseño web y comunicación',
  description: inicio?.seo?.descripcion || undefined,
  image: inicio?.seo?.imagen || undefined,
  noindex: inicio?.seo?.noindex || false,
  jsonLd,
};
---
{ajustes?.muyPronto ? (
  <Base {...seo}><MuyPronto /></Base>
) : (
  <Site {...seo}>
    <section class="mx-auto flex max-w-[1280px] flex-col gap-8 px-6 pt-10 pb-8 md:pt-22 md:pb-14">
      <p class="m-0 text-[15px] font-bold tracking-[0.04em] text-cyan-text">{inicio?.etiqueta}</p>
      <div class="flex flex-wrap items-start justify-between gap-x-12 gap-y-4">
        <h1 class="m-0 max-w-[11em] text-[clamp(30px,4vw,56px)] text-balance leading-[1.02] font-bold tracking-[-0.03em]">{inicio?.serviciosTitulo}</h1>
        <p data-no-reveal class="m-0 max-w-[400px] text-[17px] leading-normal font-bold text-orange-text md:mt-2">{inicio?.serviciosIntro}</p>
      </div>
      <div data-nosnippet class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="/proyectos" data-fx="fill" data-fx-arrow class="justify-center rounded-md bg-cyan px-[26px] py-4 text-[17px] font-bold text-navy hover:bg-cyan-hover" style="--fx-fill:#183057;--fx-text:#FFFFFF">Ver proyectos<Arrow /></a>
        <a href="/contacto" data-fx="fill" data-fx-arrow class="justify-center rounded-md border border-navy px-[25px] py-[15px] text-[17px] font-bold text-navy" style="--fx-fill:#183057;--fx-text:#FFFFFF">Hablemos<Arrow /></a>
      </div>
    </section>
    <HeroCarousel />
    <Marquee />
    <Servicios encabezado={false} />
    <Historias />
  </Site>
)}
