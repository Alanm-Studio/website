---
import Site from '../layouts/Site.astro';
import { getAjustes, breadcrumbJsonLd } from '../lib/seo';
const a = await getAjustes();
const mail = a?.email ? `mailto:${a.email}` : '/contacto';
const wa = a?.whatsapp ? `https://wa.me/${a.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('¡Hola! Quiero hablar sobre un proyecto.')}` : null;
const hablar = wa ?? mail;
// +5491162299127 → +54 9 11 6229-9127
const d = (a?.whatsapp || '').replace(/\D/g, '');
const telefono = d.length === 13 ? `+${d.slice(0, 2)} ${d[2]} ${d.slice(3, 5)} ${d.slice(5, 9)}-${d.slice(9)}` : a?.whatsapp;
const site = Astro.site!;
---
<Site title="Contacto" description="¿Tenés un proyecto en mente? Escribinos y armamos la propuesta a medida." footerCta={false}
  jsonLd={breadcrumbJsonLd(site, [{ nombre: 'Inicio', path: '/' }, { nombre: 'Contacto', path: '/contacto' }])}>
  <section class="bg-white text-navy">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-12 px-6 pt-24 pb-20">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
        <h1 class="m-0 max-w-[760px] text-[clamp(40px,5vw,64px)] leading-none font-bold tracking-[-0.035em]">¿Tenés un proyecto en mente?</h1>
        <p class="m-0 max-w-[360px] text-[19px] leading-normal text-slate-700">Contanos qué necesitás y armamos una propuesta a medida para tu marca.</p>
      </div>
      <a href={hablar} {...(wa ? { target: '_blank', rel: 'noreferrer' } : {})} class="big-link flex items-center justify-between gap-4 md:gap-8 border-y border-[#A6E6F5] py-6 text-navy" aria-label={wa ? 'Hablemos por WhatsApp (se abre en otra pestaña)' : 'Hablemos: escribinos un email'}>
        <span class="text-[clamp(44px,12.2vw,176px)] leading-[.9] font-bold tracking-[-0.055em]" aria-hidden="true">Hablemos</span>
        <span class="hb-circle relative flex h-[clamp(56px,10vw,152px)] w-[clamp(56px,10vw,152px)] flex-none items-center justify-center overflow-hidden rounded-full bg-cyan text-navy" aria-hidden="true">
          <svg class="hb-arrow absolute h-[42%] w-[42%]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
          {wa && (
            <svg class="hb-wa absolute h-[54%] w-[54%]" viewBox="0 0 24 24" fill="currentColor" preserveAspectRatio="xMidYMid meet"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          )}
        </span>
      </a>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {a?.email && (
          <div class="flex flex-col gap-2.5"><span class="text-[13px] font-bold tracking-[.08em] text-slate-500 uppercase">Escribinos</span>
            <a href={mail} class="text-[22px] md:text-[26px] leading-tight font-bold tracking-[-0.02em] [overflow-wrap:anywhere] text-orange underline decoration-2 underline-offset-[6px]">{a.email}</a></div>
        )}
        {wa && (
          <div class="flex flex-col gap-2.5"><span class="text-[13px] font-bold tracking-[.08em] text-slate-500 uppercase">WhatsApp</span>
            <a href={wa} target="_blank" rel="noreferrer" class="text-[22px] md:text-[26px] leading-tight font-bold tracking-[-0.02em] text-orange">{telefono}</a></div>
        )}
        <div class="flex flex-col gap-2.5"><span class="text-[13px] font-bold tracking-[.08em] text-slate-500 uppercase">Estudio</span>
          <span class="text-[22px] md:text-[26px] leading-tight font-bold tracking-[-0.02em]">{a?.ubicacion || 'Trenque Lauquen, Buenos Aires'}</span></div>
      </div>
    </div>
  </section>
</Site>
<style>
  /* Hover en HABLEMOS: la flecha sale disparada hacia arriba a la derecha, entra el logo de WhatsApp
     desde abajo a la izquierda y el círculo late una vez. */
  .hb-circle { transition: transform .45s cubic-bezier(.34,1.56,.64,1); }
  .hb-arrow, .hb-wa { transition: transform .45s cubic-bezier(.23,1,.32,1), opacity .3s ease; }
  .hb-wa { opacity: 0; transform: translate(-70%, 70%) scale(.6) rotate(-20deg); }
  .big-link:hover .hb-circle, .big-link:focus-visible .hb-circle { transform: scale(1.08); }
  .big-link:hover .hb-arrow, .big-link:focus-visible .hb-arrow { opacity: 0; transform: translate(70%, -70%); }
  .big-link:hover .hb-wa, .big-link:focus-visible .hb-wa { opacity: 1; transform: none; animation: hbWiggle .9s .35s ease-in-out; }
  @keyframes hbWiggle { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-12deg); } 40% { transform: rotate(10deg); } 60% { transform: rotate(-6deg); } 80% { transform: rotate(3deg); } }
  .big-link:not(:has(.hb-wa)):hover .hb-arrow { opacity: 1; transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) {
    .hb-circle, .hb-arrow, .hb-wa { transition: opacity .2s ease; }
    .big-link:hover .hb-circle { transform: none; }
    .big-link:hover .hb-arrow { transform: none; }
    .hb-wa, .big-link:hover .hb-wa { transform: none; animation: none; }
  }
</style>
