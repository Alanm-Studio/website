---
import Site from '../layouts/Site.astro';
import Wordmark from '../components/Wordmark.astro';
import { getAjustes, breadcrumbJsonLd } from '../lib/seo';
const a = await getAjustes();
const mail = a?.email ? `mailto:${a.email}` : '/contacto';
const wa = a?.whatsapp ? `https://wa.me/${a.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('¡Hola! Quiero hablar sobre un proyecto.')}` : null;
const hablar = wa ?? mail;
const redes = [
  { label: 'Instagram', href: a?.instagram },
  { label: 'Behance', href: a?.behance },
  { label: 'LinkedIn', href: a?.linkedin },
].filter((r) => r.href);
const site = Astro.site!;
---
<Site title="Contacto" description="¿Tenés un proyecto en mente? Escribinos y armamos la propuesta a medida." footer={false}
  jsonLd={breadcrumbJsonLd(site, [{ nombre: 'Inicio', path: '/' }, { nombre: 'Contacto', path: '/contacto' }])}>
  <div class="flex min-h-[calc(100dvh-77px)] flex-col justify-between gap-12 bg-cyan px-6 pt-20 pb-10 text-navy md:px-16">
    <h1 class="m-0 text-[22px] font-bold">¿Tenés un proyecto en mente?</h1>
    <a href={hablar} {...(wa ? { target: '_blank', rel: 'noreferrer' } : {})} class="big-link flex items-center justify-between gap-8 border-b-4 border-navy pb-6 text-navy" aria-label={wa ? 'Hablemos por WhatsApp (se abre en otra pestaña)' : 'Hablemos: escribinos un email'}>
      <span class="font-display text-[clamp(64px,13vw,184px)] leading-[.95] tracking-[-0.01em]" aria-hidden="true">HABLEMOS</span>
      <span class="hb-circle relative flex h-[clamp(72px,10vw,152px)] w-[clamp(72px,10vw,152px)] flex-none items-center justify-center overflow-hidden rounded-full bg-orange text-white" aria-hidden="true">
        <svg class="hb-arrow absolute h-1/2 w-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>
        {wa && (
          <svg class="hb-wa absolute h-[54%] w-[54%]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <path d="M3.6 20.4l1.25-4.1A8.6 8.6 0 1 1 8.1 19.5z" />
            <path fill="currentColor" stroke="none" d="M9.05 7.7c.3-.3.8-.27 1.02.08l.85 1.55c.17.31.11.7-.14.95l-.55.55c.52 1.12 1.42 2.03 2.55 2.55l.55-.55c.25-.25.64-.31.95-.14l1.55.85c.35.2.39.7.08 1.02l-.72.75c-.52.52-1.31.66-1.97.36a9.2 9.2 0 0 1-4.53-4.53c-.3-.66-.16-1.45.36-1.97z" />
          </svg>
        )}
      </span>
    </a>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <div class="flex flex-col gap-2"><span class="text-sm font-bold">Escribinos</span>
        {a?.email ? <a href={mail} class="py-1 text-[28px] font-bold tracking-[-0.02em] text-navy underline underline-offset-4">{a.email}</a> : <span class="text-lg">Email a confirmar</span>}
        {wa && <a href={wa} class="py-1 text-lg font-bold text-navy underline underline-offset-4">WhatsApp</a>}
      </div>
      <nav aria-label="Navegación" class="flex flex-col"><span class="mb-1.5 text-sm font-bold">Navegación</span>
        <a href="/proyectos" class="py-1.5 text-lg text-navy">Proyectos</a><a href="/equipo" class="py-1.5 text-lg text-navy">Equipo</a><a href="/" class="py-1.5 text-lg text-navy">Inicio</a>
      </nav>
      {redes.length > 0 && <div class="flex flex-col"><span class="mb-1.5 text-sm font-bold">Redes</span>{redes.map((r) => <a href={r.href} class="py-1.5 text-lg text-navy">{r.label}</a>)}</div>}
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4 border-t border-navy pt-6">
      <Wordmark class="text-5xl" />
      <span class="text-sm">© {new Date().getFullYear()} Alan Marino · {a?.ubicacion || 'Trenque Lauquen, Buenos Aires'}</span>
    </div>
  </div>
</Site>
<style>
  /* Hover en HABLEMOS: la flecha sale disparada hacia arriba a la derecha, entra el logo de WhatsApp
     desde abajo a la izquierda y el círculo late una vez. */
  .hb-circle { transition: transform .45s cubic-bezier(.34,1.56,.64,1); }
  .hb-arrow, .hb-wa { transition: transform .45s cubic-bezier(.23,1,.32,1), opacity .3s ease; }
  .hb-wa { opacity: 0; transform: translate(-70%, 70%) scale(.6) rotate(-20deg); }
  .big-link:hover .hb-circle, .big-link:focus-visible .hb-circle { transform: scale(1.08); }
  .big-link:hover .hb-arrow, .big-link:focus-visible .hb-arrow { opacity: 0; transform: translate(70%, -70%); }
  .big-link:hover .hb-wa, .big-link:focus-visible .hb-wa { opacity: 1; transform: none; animation: hbWiggle .9s .35s ease-in-out; }
  @keyframes hbWiggle { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-12deg); } 40% { transform: rotate(10deg); } 60% { transform: rotate(-6deg); } 80% { transform: rotate(3deg); } }
  .big-link:not(:has(.hb-wa)):hover .hb-arrow { opacity: 1; transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) {
    .hb-circle, .hb-arrow, .hb-wa { transition: opacity .2s ease; }
    .big-link:hover .hb-circle { transform: none; }
    .big-link:hover .hb-arrow { transform: none; }
    .hb-wa, .big-link:hover .hb-wa { transform: none; animation: none; }
  }
</style>
