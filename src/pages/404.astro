---
import Site from '../layouts/Site.astro';
---
<Site title="Página no encontrada" noindex>
  <section class="mx-auto flex max-w-[1280px] flex-col items-start gap-6 px-6 py-32">
    <p class="m-0 text-[15px] font-bold text-cyan-text">Error 404</p>
    <h1 class="m-0 text-[clamp(48px,7vw,96px)] leading-[.98] font-bold tracking-[-0.035em]">Esta página no existe.</h1>
    <a href="/" class="rounded-md bg-orange px-6 py-4 text-lg font-bold text-white hover:bg-orange-hover">Volver al inicio</a>
  </section>
</Site>
