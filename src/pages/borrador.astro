---
// Vista interna (no indexada) para comprobar que el contenido de Keystatic llega al sitio.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { reader, getServicios, getEquipo, getMarcas, getProyectos } from '../lib/cms';

const inicio = await reader.singletons.inicio.read();
const servicios = await getServicios();
const equipo = await getEquipo();
const marcas = await getMarcas();
const proyectos = await getProyectos();
---
<Base title="Borrador" noindex>
  <header class="sticky top-0 z-10 border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-[1280px] items-center justify-between px-6 py-[18px]">
      <Logo class="h-7 w-auto" />
      <span class="text-sm font-bold text-cyan-text">Borrador interno · contenido desde Keystatic</span>
    </div>
  </header>

  <section class="mx-auto max-w-[1280px] px-6 pt-22 pb-14">
    <p class="text-[15px] font-bold tracking-[0.04em] text-cyan-text">{inicio?.etiqueta}</p>
    <h1 class="mt-7 text-[clamp(48px,7.4vw,104px)] leading-[.98] font-bold tracking-[-0.035em]">{inicio?.titulo}</h1>
    <p class="mt-7 max-w-[620px] text-xl leading-normal text-slate-700">{inicio?.intro}</p>
  </section>

  <div class="bg-slate-50">
    <section id="servicios" aria-labelledby="serv-t" class="mx-auto max-w-[1312px] px-6 md:px-16">
      <div class="flex flex-wrap items-start justify-between gap-12 pt-24 pb-18">
        <h2 id="serv-t" class="m-0 max-w-[680px] text-[clamp(36px,4vw,56px)] leading-[1.02] font-bold tracking-[-0.03em]">{inicio?.serviciosTitulo}</h2>
        <p class="m-0 max-w-[400px] text-[17px] leading-normal font-bold text-orange-text">{inicio?.serviciosIntro}</p>
      </div>
      {servicios.map(({ entry }, i) => (
        <article
          class="sticky grid h-[500px] grid-cols-1 gap-8 border-t border-cyan bg-slate-50 pt-[22px] pb-10 md:grid-cols-[140px_minmax(0,1fr)_400px]"
          style={`top: ${96 + i * 84}px`}
        >
          <span class="text-4xl leading-none font-bold tracking-[-0.02em]">{String(i + 1).padStart(2, '0')}</span>
          <div class="flex flex-col gap-2.5">
            <h3 class="m-0 text-[38px] leading-none font-bold tracking-[-0.025em] text-orange">{entry.titulo}</h3>
            <span class="mt-4 text-[13px] text-orange-text">[ {entry.bajada} ]</span>
            <ul class="m-0 flex list-none flex-col gap-1.5 p-0">
              {entry.items.map((it) => <li class="text-lg leading-snug text-slate-700">{it}</li>)}
            </ul>
          </div>
          <p class="m-0 text-base leading-normal font-bold md:mt-[74px]">{entry.descripcion}</p>
        </article>
      ))}
      <div class="h-[360px]"></div>
    </section>
  </div>

  <section aria-labelledby="eq-t" class="mx-auto max-w-[1280px] px-6 py-24">
    <h2 id="eq-t" class="mb-12 text-[clamp(36px,5vw,72px)] leading-none font-bold tracking-[-0.035em]">Equipo</h2>
    <div class="grid grid-cols-1 gap-x-8 gap-y-18 md:grid-cols-2">
      {equipo.map(({ entry }) => (
        <article class="flex flex-col gap-4">
          {entry.foto
            ? <img src={entry.foto} alt={`Retrato de ${entry.nombre}`} class="aspect-[3/4] w-full rounded-md object-cover" loading="lazy" />
            : <div class="flex aspect-[3/4] items-end rounded-md bg-slate-100 p-4 text-[13px] text-slate-700">Falta el retrato · cargalo en Keystatic</div>}
          <div>
            <h3 class="m-0 text-2xl font-bold tracking-[-0.01em]">{entry.nombre}</h3>
            <span class="text-[15px] font-bold text-cyan-text">{entry.rol}</span>
          </div>
          <p class="m-0 text-lg leading-snug font-bold">{entry.frase}</p>
          <p class="m-0 text-base leading-relaxed text-slate-700">{entry.bio}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-navy py-14 text-white">
    <div class="mx-auto max-w-[1280px] px-6">
      <h2 class="text-[28px] font-bold">Marcas ({marcas.length})</h2>
      <p class="mt-2 text-slate-200">{marcas.map((m) => m.entry.nombre).join(' · ')}</p>
      <h2 class="mt-10 text-[28px] font-bold">Proyectos publicados ({proyectos.length})</h2>
      <p class="mt-2 text-slate-200">{proyectos.length ? proyectos.map((p) => p.entry.titulo).join(' · ') : 'Todavía no hay proyectos publicados.'}</p>
    </div>
  </section>
</Base>
