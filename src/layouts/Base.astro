---
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Alan Marino Studio. Branding, diseño web y comunicación para marcas en crecimiento.', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00C0E8" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bowlby+One&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
