---
import '@fontsource/bowlby-one/400.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';

type SeoProps = import('astro/types').ComponentProps<typeof Seo>;
interface Props extends SeoProps {}
const props = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-5HKL5V5M');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...props} />
    <meta name="theme-color" content="#00C0E8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion');
      setTimeout(function () { document.documentElement.classList.add('motion-ready'); }, 3000);
    }
  </script>
</head>
  <body class="bg-white text-navy antialiased">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5HKL5V5M" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
    <script>import '../scripts/smooth';</script>
    <script>import '../scripts/fx';</script>
    <script>import '../scripts/motion';</script>
  </body>
</html>
